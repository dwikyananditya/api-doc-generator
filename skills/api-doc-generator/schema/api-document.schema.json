{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metadata",
    "endpoints"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "documentName",
        "service",
        "version",
        "date",
        "author",
        "status",
        "classification"
      ],
      "properties": {
        "documentName": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/endpointDocument"
      }
    }
  },
  "$defs": {
    "endpointDocument": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "endpoint",
        "sections"
      ],
      "properties": {
        "endpoint": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "method",
            "url",
            "controller",
            "serviceMethod"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "functionName": {
              "type": "string"
            },
            "controller": {
              "type": "string",
              "minLength": 1
            },
            "serviceMethod": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "type": "string"
            },
            "contentType": {
              "type": "string"
            },
            "successStatus": {
              "type": [
                "integer",
                "string"
              ]
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Other routes that call the same handler, e.g. \"GET /web/orders/:id\""
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "overview",
            "businessProcess",
            "systemInteraction",
            "database",
            "externalApis",
            "errorHandling",
            "risks",
            "recommendations",
            "response"
          ],
          "properties": {
            "overview": {
              "type": "object",
              "required": [
                "controller",
                "routePrefix",
                "endpoints",
                "requestFields"
              ],
              "properties": {
                "controller": {
                  "type": "string"
                },
                "routePrefix": {
                  "type": "string"
                },
                "endpoints": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/endpointSummary"
                  }
                },
                "requestFields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/requestField"
                  }
                }
              }
            },
            "businessProcess": {
              "type": "object",
              "required": [
                "steps",
                "failureBehavior"
              ],
              "properties": {
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "failureBehavior": {
                  "type": "string"
                }
              }
            },
            "systemInteraction": {
              "type": "object",
              "required": [
                "services",
                "sequence",
                "communication"
              ],
              "properties": {
                "services": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "sequence": {
                  "type": "string"
                },
                "communication": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "database": {
              "type": "object",
              "required": [
                "read",
                "write"
              ],
              "properties": {
                "read": {},
                "write": {}
              }
            },
            "externalApis": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/externalApi"
              }
            },
            "errorHandling": {
              "type": "object",
              "required": [
                "businessRuleValidation",
                "fallbackValues",
                "generalPropagation",
                "unhandled"
              ],
              "properties": {
                "businessRuleValidation": {
                  "type": "array"
                },
                "fallbackValues": {
                  "type": "array"
                },
                "generalPropagation": {
                  "type": "array"
                },
                "unhandled": {
                  "type": "string"
                }
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/risk"
              }
            },
            "recommendations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/recommendation"
              }
            },
            "response": {
              "type": "object",
              "required": [
                "success",
                "fields",
                "errors",
                "clientGuidance"
              ],
              "properties": {
                "success": {},
                "fields": {
                  "type": "array"
                },
                "errors": {
                  "type": "array"
                },
                "clientGuidance": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "endpointSummary": {
      "type": "object",
      "required": [
        "method",
        "path",
        "handler",
        "queryDto"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "queryDto": {
          "type": "string"
        }
      }
    },
    "requestField": {
      "type": "object",
      "required": [
        "field",
        "type",
        "required",
        "validation",
        "source"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "validation": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "externalApi": {
      "type": "object",
      "required": [
        "endpoint",
        "method",
        "query",
        "execution",
        "purpose"
      ],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "query": {},
        "execution": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "severity",
        "scenario",
        "trigger",
        "businessImpact"
      ],
      "properties": {
        "severity": {
          "enum": [
            "red",
            "amber",
            "info"
          ]
        },
        "scenario": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "businessImpact": {
          "type": "string"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "priority",
        "title",
        "problem",
        "solution"
      ],
      "properties": {
        "priority": {
          "type": [
            "integer",
            "string"
          ]
        },
        "title": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        }
      }
    }
  }
}
