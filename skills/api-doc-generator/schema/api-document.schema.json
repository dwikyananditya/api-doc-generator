{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API document",
  "type": "object",
  "required": ["metadata", "services", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["documentName", "service", "version", "date", "author", "status", "classification"],
      "additionalProperties": false,
      "properties": {
        "documentName": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "repo", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "envVar": { "type": "string" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "method", "url", "aliases", "summary", "auth", "handler", "flow", "request", "downstream", "database", "response", "notes"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
          "url": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string", "minLength": 1 },
          "auth": { "type": "string", "minLength": 1 },
          "handler": { "type": "string", "minLength": 1 },
          "flow": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "request": {
            "type": "object",
            "required": ["contentType", "dto", "pathParams", "queryParams", "body", "example"],
            "additionalProperties": false,
            "properties": {
              "contentType": { "type": "string", "minLength": 1 },
              "dto": { "type": "string", "minLength": 1 },
              "pathParams": { "$ref": "#/$defs/fields" },
              "queryParams": { "$ref": "#/$defs/fields" },
              "body": { "$ref": "#/$defs/fields" },
              "example": { "type": ["object", "array", "string", "null"] }
            }
          },
          "downstream": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["service", "call", "purpose", "handler"],
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string", "minLength": 1 },
                "call": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string", "minLength": 1 },
                "handler": { "type": "string", "minLength": 1 }
              }
            }
          },
          "database": {
            "type": "object",
            "required": ["queries", "relations"],
            "additionalProperties": false,
            "properties": {
              "queries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["service", "table", "operation", "filter", "purpose"],
                  "additionalProperties": false,
                  "properties": {
                    "service": { "type": "string", "minLength": 1 },
                    "table": { "type": "string", "minLength": 1 },
                    "operation": { "type": "string", "enum": ["Baca", "Tambah", "Ubah", "Hapus"] },
                    "filter": { "type": "string", "minLength": 1 },
                    "purpose": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to", "kind", "meaning"],
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "to": { "type": "string", "minLength": 1 },
                    "kind": { "type": "string", "minLength": 1 },
                    "meaning": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "response": {
            "type": "object",
            "required": ["status", "example", "fields", "errors"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "integer" },
              "example": { "type": ["object", "array", "string", "null"] },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["status", "condition", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "status": { "type": "integer" },
                    "condition": { "type": "string", "minLength": 1 },
                    "message": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "type", "required", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
